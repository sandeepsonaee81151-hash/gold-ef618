rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public website imagery can be read by visitors; only project admins upload.
    match /site-images/{imagePath=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
